BOT_TOKEN=ВСТАВЬ_НОВЫЙ_ТОКЕН_ОТ_BOTFATHER
SFU_TZ=Asia/Krasnoyarsk
DATA_DIR=data
API_HOST=127.0.0.1
API_PORT=8080

# Где лежит страница mini app. Локально — этот же сервер.
# На Render можно не задавать: адрес соберётся из RENDER_EXTERNAL_URL.
MINIAPP_URL=http://127.0.0.1:8080/miniapp

# Публичный адрес API, если он отличается от адреса страницы
# (например, страница на GitHub Pages, а API на Render).
# PUBLIC_API_URL=https://ИМЯ-СЕРВИСА.onrender.com

SSL_VERIFY=true
# Сколько минут держать в кэше индекс преподавателей института.
TEACHER_CACHE_TTL=360
